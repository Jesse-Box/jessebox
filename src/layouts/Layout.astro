---
import { Font } from "astro:assets"
import "../styles/global.css"

interface Props {
  title: string
  description?: string
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {canonical && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        {description && (
          <meta property="og:description" content={description} />
        )}
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        {description && (
          <meta name="twitter:description" content={description} />
        )}
      </>
    )}

    <Font cssVariable="--font-gt-flexa-expanded" preload />
    <Font cssVariable="--font-gt-flexa" preload />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    max-width: 55ch;
    padding-block: clamp(var(--space-4), 10vw, var(--space-6));
    padding-inline: clamp(var(--space-3), 12vw - 3rem, var(--space-7));
    box-sizing: content-box;
  }
</style>
